<?xml version="1.0"?>
<robot name="multipleshapes" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- constants -->
  <xacro:property name="pi" value="3.1415926535897931"/>

  <xacro:property name="d1" value="1.0" />
  <xacro:property name="d2" value="1.0" />
  <xacro:property name="d3" value="0.3" />

  <xacro:property name="link_1_h" value="0.475" />
  <xacro:property name="link_1_w" value="0.2" />
  <xacro:property name="link_2_h" value="0.2" />
  <xacro:property name="link_2_w" value="0.2" />
  <xacro:property name="link_3_s" value="0.4" />

  <xacro:property name="ee_w" value="0.4" />
  <xacro:property name="ee_h" value="0.05" />
  <xacro:property name="ee_limit_lower" value="0.0" />
  <xacro:property name="ee_limit_upper" value="0.5" />

  <!-- Base -->
  <link name="base_link">
    <!-- Optional: give base something visible -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.2 0.2 0.05"/>
      </geometry>
    </visual>
    <!-- Optional inertial (helps Gazebo) -->
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>

  <link name="link_1">
    <visual>
      <!-- cylinder is centered; lift it so it sits above joint -->
      <origin xyz="0 0 ${link_1_h/2.0}" rpy="0 0 0"/>
      <geometry>
        <cylinder length="${link_1_h}" radius="${link_1_w}" />
      </geometry>
    </visual>
    <inertial>
      <origin xyz="0 0 ${link_1_h/2.0}" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.02"/>
    </inertial>
  </link>

  <joint name="base_to_link_1" type="continuous">
    <parent link="base_link" />
    <child link="link_1" />
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1" />
  </joint>

  <link name="link_2">
    <visual>
      <origin xyz="0 0 ${link_2_h/2.0}" rpy="0 0 0"/>
      <geometry>
        <cylinder length="${link_2_h}" radius="${link_2_w}" />
      </geometry>
    </visual>
    <inertial>
      <origin xyz="0 0 ${link_2_h/2.0}" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>

  <joint name="link_1_to_link_2" type="continuous">
    <parent link="link_1" />
    <child link="link_2" />
    <!-- place joint at top of link_1 -->
    <origin xyz="0 0 ${link_1_h}" rpy="${pi/2} 0 0" />
    <axis xyz="0 0 1" />
  </joint>

  <link name="link_3">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${link_3_s} ${link_3_s} ${link_3_s}" />
      </geometry>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>

  <joint name="link_2_to_link_3" type="fixed">
    <parent link="link_2" />
    <child link="link_3" />
    <!-- place at top of link_2 -->
    <origin xyz="0 0 ${link_2_h}" rpy="${pi/2} 0 ${pi/2}" />
  </joint>

  <link name="end_effector">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${ee_w} ${ee_w} ${ee_h}" />
      </geometry>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.005"/>
    </inertial>
  </link>

  <joint name="link_3_to_end_effector" type="prismatic">
    <parent link="link_3" />
    <child link="end_effector" />
    <origin xyz="0 0 ${d3}" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="${ee_limit_lower}" upper="${ee_limit_upper}" effort="100" velocity="1.0"/>
  </joint>

</robot>