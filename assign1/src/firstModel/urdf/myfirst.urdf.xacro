<?xml version="1.0"?>
<robot name="3dof_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="d1" value="0.475" />
    <xacro:property name="d2" value=".600" />
    <xacro:property name="d3" value="0.3" />
    <xacro:property name="base_link_w" value="1" />
    <xacro:property name="base_link_h" value="1" />
    <xacro:property name="base_link_t" value="0.1" />
    <xacro:property name="link_rev_h" value="0.1" />
    <xacro:property name="link_rev_r" value="0.1" />
    <xacro:property name="link_3_s" value=".4" />

    <xacro:property name="ee_w" value="0.4" />
    <xacro:property name="ee_h" value="0.05" />
    <xacro:property name="ee_limit_lower" value="0" />
    <xacro:property name="ee_limit_upper" value=".5" />


    <link name="base_link">
        <visual>
            <geometry>
                <box size="${base_link_w} ${base_link_h} ${base_link_t}" />
            </geometry>
        </visual>
        <collision>
            <geometry>
                <box size="${base_link_w} ${base_link_h} ${base_link_t}" />
            </geometry>
        </collision>
        <inertial>
            <origin rpy="0 0 0" xyz="0 0 0" />
            <mass value="100" />
            <inertia ixx="1e-3" ixy="0" ixz="0" iyy="1e-3" iyz="0" izz="1e-3" />
        </inertial>
    </link>

    <link name="link_1">
        <origin rpy="0 0 0" xyz="0 0 ${base_link_t + link_rev_h/2}" />
        <visual>
            <geometry>
                <cylinder length="${link_rev_h}" radius="${link_rev_r}" />
            </geometry>
        </visual>
        <collision>
            <geometry>
                <cylinder length="${link_rev_h}" radius="${link_rev_r}" />
            </geometry>
        </collision>
        <inertial>
            <mass value="10" />
            <inertia ixx="1e-3" ixy="0.0" ixz="0.0" iyy="1e-3" iyz="0.0" izz="1e-3" />
        </inertial>
    </link>

    <joint name="base_to_link_1" type="continuous">
        <parent link="base_link" />
        <child link="link_1" />
        <origin rpy="0 0 0" xyz="0 0 0" />
        <axis xyz="0 0 1" />
    </joint>

    <link name="link_2">
        <visual>
            <geometry>
                <cylinder length="${link_rev_h}" radius="${link_rev_r}" />
            </geometry>
        </visual>
        <collision>
            <geometry>
                <cylinder length="${link_rev_h}" radius="${link_rev_r}" />
            </geometry>
        </collision>
        <inertial>
            <mass value="10" />
            <inertia ixx="1e-3" ixy="0.0" ixz="0.0" iyy="1e-3" iyz="0.0" izz="1e-3" />
        </inertial>
    </link>

    <joint name="link_1_to_link_2" type="continuous">
        <parent link="link_1" />
        <child link="link_2" />
        <origin rpy="${pi/2} 0 0" xyz="0 0 ${d2}" />
        <!-- <limit lower="${-pi/4}" upper="${pi}" effort="100" velocity="1.0" /> -->
        <axis xyz="0 0 1" />
    </joint>

    <link name="link_3">
        <visual>
            <geometry>
                <cylinder length="${link_rev_h}" radius="${link_rev_r}" />
            </geometry>
        </visual>
        <collision>
            <geometry>
                <cylinder length="${link_rev_h}" radius="${link_rev_r}" />
            </geometry>
        </collision>
        <inertial>
            <mass value="10" />
            <inertia ixx="1e-3" ixy="0.0" ixz="0.0" iyy="1e-3" iyz="0.0" izz="1e-3" />
        </inertial>
    </link>

    <joint name="link_2_to_link_3" type="revolute">
        <parent link="link_2" />
        <child link="link_3" />
        <origin rpy="0 0 0" xyz="${d2} 0 0" />
        <limit lower="${-pi/4}" upper="${pi}" effort="100" velocity="1.0" />
        <axis xyz="0 0 1" />
    </joint>

    <!-- <link name="link_3">
        <visual>
            <geometry>
                <cylinder length="${link_rev_h}" radius="${link_rev_r}" />
            </geometry>
        </visual>
        <collision>
            <geometry>
                <cylinder length="${link_rev_h}" radius="${link_rev_r}" />
            </geometry>
        </collision>
        <inertial>
            <mass value="10" />
            <inertia ixx="1e-3" ixy="0.0" ixz="0.0" iyy="1e-3" iyz="0.0" izz="1e-3" />
        </inertial>
    </link>

    <joint name="link_2_to_link_3" type="revolute">
        <parent link="link_2" />
        <child link="link_3" />
        <origin rpy="0 0 0" xyz="${d2} 0 0" />
        <limit lower="${-pi/4}" upper="${pi}" effort="100" velocity="1.0" />
        <axis xyz="0 0 1" />
    </joint> -->

    

</robot>