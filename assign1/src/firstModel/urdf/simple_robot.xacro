<?xml version="1.0"?>
<robot name="simple_one_piece_robot">

  <!-- Base link: a simple cylinder standing upright -->
  <link name="base_link">

    <!-- Visual: how it looks in Gazebo / RViz -->
    <visual>
      <origin xyz="0 0 0.5" rpy="0 0 0"/>  <!-- center of mass at 0.5 m height -->
      <geometry>
        <cylinder length="1.0" radius="0.1"/>
      </geometry>
      <material name="blue">
        <color rgba="0.0 0.3 1.0 1.0"/>
      </material>
    </visual>

    <!-- Collision: how it interacts physically -->
    <collision>
      <origin xyz="0 0 0.5" rpy="0 0 0"/>
      <geometry>
        <cylinder length="1.0" radius="0.1"/>
      </geometry>
    </collision>

    <!-- Inertial: needed for realistic physics (mass & inertia) -->
    <inertial>
      <origin xyz="0 0 0.5" rpy="0 0 0"/>
      <mass value="5.0"/>
      <inertia
        ixx="0.1" ixy="0.0" ixz="0.0"
        iyy="0.1" iyz="0.0"
        izz="0.01"/>
    </inertial>

  </link>

  <!-- Optional: fix to world if you want it static (uncomment if needed) -->
  <!--
  <link name="world"/>
  <joint name="world_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.5" rpy="0 0 0"/>
  </joint>
  -->

</robot>